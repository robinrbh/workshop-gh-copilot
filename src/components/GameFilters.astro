---
import type { Category, Publisher } from '../types/game';

/** Props for the game filter controls. */
interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    role="search"
    aria-label="Filter games"
    data-testid="game-filters"
    class="mb-6 bg-slate-800/60 border border-slate-700 rounded-xl p-4 space-y-4"
    onsubmit="return false"
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-200 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="flex items-center gap-2 text-sm text-slate-200 bg-slate-900 border border-slate-600 rounded-lg px-3 py-1.5 cursor-pointer hover:bg-slate-700 transition-colors duration-200 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="publisher-filter" class="block text-sm font-medium text-slate-200 mb-2">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                class="bg-slate-900 text-slate-100 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="button"
            class="bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm rounded-lg px-4 py-2 transition-colors duration-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>

        <p
            role="status"
            aria-live="polite"
            class="text-sm text-slate-300 ml-auto"
            data-testid="filter-result-count"
        ></p>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const noMatches = document.querySelector<HTMLElement>('[data-testid="filter-no-matches"]');
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const count = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
    const checkboxes = Array.from(
        form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? [],
    );
    const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clearButton = form?.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

    /**
     * Shows only the cards matching the selected categories (any) and publisher,
     * updates the result count and empty state, and optionally syncs the URL query.
     * @param updateUrl - Whether to reflect the current selection in the URL.
     */
    function applyFilters(updateUrl: boolean): void {
        const selectedCategories = checkboxes.filter((c) => c.checked).map((c) => c.value);
        const publisher = publisherSelect?.value ?? '';

        let visible = 0;
        for (const card of cards) {
            const matches =
                (selectedCategories.length === 0 ||
                    selectedCategories.includes(card.dataset.categoryId ?? '')) &&
                (publisher === '' || card.dataset.publisherId === publisher);
            card.classList.toggle('hidden!', !matches);
            if (matches) visible++;
        }

        if (count) count.textContent = `Showing ${visible} of ${cards.length} games`;
        if (noMatches) noMatches.hidden = visible !== 0;
        if (grid) grid.classList.toggle('hidden!', visible === 0);

        if (updateUrl) {
            const params = new URLSearchParams();
            selectedCategories.forEach((id) => params.append('category', id));
            if (publisher) params.set('publisher', publisher);
            const query = params.toString();
            history.replaceState(null, '', query ? `?${query}` : location.pathname);
        }
    }

    if (form) {
        const params = new URLSearchParams(location.search);
        const initialCategories = params.getAll('category');
        checkboxes.forEach((c) => {
            c.checked = initialCategories.includes(c.value);
        });
        if (publisherSelect) {
            publisherSelect.value = params.get('publisher') ?? '';
            if (publisherSelect.selectedIndex === -1) publisherSelect.value = '';
        }

        form.addEventListener('change', () => applyFilters(true));
        clearButton?.addEventListener('click', () => {
            checkboxes.forEach((c) => {
                c.checked = false;
            });
            if (publisherSelect) publisherSelect.value = '';
            applyFilters(true);
        });
        applyFilters(false);
    }
</script>
